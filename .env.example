# Copy to .env.local for local development. On Vercel, add each of these in
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key. SERVER ONLY — never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# A long random string used to sign login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The administrator (you). Not stored in the database.
ADMIN_USERNAME=admin
# Preferred: a hash made with  npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# Alternative (less safe): the plain password. Ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=
